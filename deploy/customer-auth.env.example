# Keep the real file outside checkout, mode 600. All placeholders must be replaced.
NODE_ENV=production
JCADB_TENANT=__PLACEHOLDER_TENANT__
JCADB_PUBLIC_ORIGIN=https://gw.__PLACEHOLDER_TENANT__.jgw.test
KC_PUBLIC_URL=https://auth.jgw.test
JCADB_PORT=55071
JCADB_DB_HOST=127.0.0.1
JCADB_DB_PORT=5432
JCADB_DB_NAME=jgw_customer_auth
JCADB_DB_USER=jgw_customer_auth
JCADB_DB_PASSWORD=__PLACEHOLDER_DATABASE_PASSWORD__
JCADB_CURSOR_SIGNING_KEY=__PLACEHOLDER_INDEPENDENT_32_BYTE_BASE64URL_KEY__
JCADB_TLS_CERTIFICATE=/etc/jgw/private/customer-auth/server.crt
JCADB_TLS_KEY=/etc/jgw/private/customer-auth/server.key
JCADB_CA_CERTIFICATE=/etc/jgw/private/ca.crt
JCADB_GUEST_SIGNING_KEY=/etc/jgw/private/customer-auth/guest-signing.key
